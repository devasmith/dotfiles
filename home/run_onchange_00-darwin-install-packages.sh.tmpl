#!/bin/bash
set -euo pipefail

# Re-run when the Brewfile changes
# Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}

# Homebrew
if [[ "$(uname -m)" == "arm64" ]]; then
  BREW=/opt/homebrew/bin/brew
else
  BREW=/usr/local/bin/brew
fi

if [[ ! -x "$BREW" ]]; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$("$BREW" shellenv)"

echo "Installing Homebrew packages..."
brew bundle --file={{ joinPath .chezmoi.sourceDir "dot_Brewfile" | quote }}

mkdir -p "$HOME/.local/bin"

# Remove the bootstrap pass-cli so Homebrew's are used
rm -f "$HOME/.local/bin/pass-cli"

# Go packages
if [[ ! -x "$(go env GOPATH)/bin/gup" ]]; then
  go install github.com/nao1215/gup@latest
fi
